# Copy to .env and fill in locally. .env is git-ignored — never commit real values.

# --- LLM / Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=llama3.1:8b,qwen2.5:72b,phi4:14b

# --- Frontier model ---
ANTHROPIC_API_KEY=your-key-here

# --- Databases ---
SQLSERVER_HOST=localhost
SQLSERVER_DB=platform_ops
SQLSERVER_USER=app_readwrite
SQLSERVER_PASSWORD=your-password-here
CHROMA_PATH=./chroma

# --- Agents ---
RESEARCH_AGENT_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:8002
EXECUTION_AGENT_URL=http://localhost:8003
SUPERVISOR_URL=http://localhost:8004

# --- Brokerage / execution (keep in .env only) ---
BROKER_API_KEY=your-key-here
BROKER_API_SECRET=your-secret-here
BROKER_PAPER=true
